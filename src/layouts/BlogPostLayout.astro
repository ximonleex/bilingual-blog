---
import BaseLayout from './BaseLayout.astro';
import { getLangFromUrl, useTranslations, formatDate, getLocalePath } from '../i18n/utils';
import type { BlogPost } from '../content/config';

interface Props {
  post: BlogPost & { slug: string };
  lang: 'en' | 'zh';
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const categoryLabel = t(`category.${post.category}` as any) || post.category;
---

<BaseLayout
  title={post.title}
  description={post.description}
  lang={lang}
  image={post.image?.url}
  type="article"
  pubDate={post.pubDate}
  author={post.author}
>
  <article class="blog-post">
    <div class="blog-post__hero">
      <div class="container">
        <div class="blog-post__breadcrumb">
          <a href={getLocalePath(lang)}>{t('nav.home')}</a>
          <span>›</span>
          <a href={getLocalePath(lang, 'blog')}>{t('nav.blog')}</a>
          <span>›</span>
          <span class="blog-post__category-crumb">{categoryLabel}</span>
        </div>

        <div class="blog-post__meta-bar">
          <span class="blog-post__category-badge">{categoryLabel}</span>
          <time datetime={post.pubDate.toISOString()} class="blog-post__date">
            {t('blog.publishedOn')} {formatDate(post.pubDate, lang)}
          </time>
        </div>

        <h1 class="blog-post__title">{post.title}</h1>
        <p class="blog-post__description">{post.description}</p>

        {post.tags && post.tags.length > 0 && (
          <div class="blog-post__tags">
            {post.tags.map((tag) => (
              <span class="blog-post__tag">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    {post.image && (
      <div class="blog-post__cover container">
        <img
          src={post.image.url}
          alt={post.image.alt}
          loading="eager"
          decoding="async"
          class="blog-post__cover-img"
        />
      </div>
    )}

    <div class="container blog-post__content-wrap">
      <div class="blog-post__content prose">
        <slot />
      </div>

      <aside class="blog-post__sidebar">
        <div class="blog-post__author-card">
          <div class="author-avatar">✦</div>
          <div>
            <p class="author-name">{post.author || 'AI Side Hustle'}</p>
            <p class="author-desc">
              {lang === 'zh' ? '帮助全球华人用AI赚钱' : 'Helping the global Chinese community earn with AI'}
            </p>
          </div>
        </div>

        <div class="blog-post__share">
          <p class="share-label">{t('blog.share')}</p>
          <div class="share-buttons">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn share-btn--twitter"
            >
              𝕏 Twitter
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post__hero {
    padding: 3rem 0 2.5rem;
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, transparent 100%);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
  }

  .blog-post__breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .blog-post__breadcrumb a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .blog-post__breadcrumb a:hover {
    color: var(--color-accent-light);
  }

  .blog-post__category-crumb {
    color: var(--color-accent-light);
  }

  .blog-post__meta-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .blog-post__category-badge {
    display: inline-flex;
    padding: 0.25rem 0.75rem;
    background: var(--color-accent-glow);
    color: var(--color-accent-light);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-post__date {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .blog-post__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 1rem;
    max-width: 800px;
  }

  .blog-post__description {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    max-width: 700px;
    margin-bottom: 1.25rem;
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blog-post__tag {
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
    background: var(--color-bg-tertiary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .blog-post__cover {
    margin-bottom: 2.5rem;
  }

  .blog-post__cover-img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
  }

  .blog-post__content-wrap {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }

  /* ---- PROSE ---- */
  .prose {
    color: var(--color-text);
    max-width: 720px;
  }

  .prose :global(h2) {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    color: var(--color-text);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .prose :global(h3) {
    font-size: var(--font-size-xl);
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    color: var(--color-text-muted);
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .prose :global(a:hover) {
    color: var(--color-accent);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: var(--color-accent-glow);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(code) {
    background: var(--color-bg-tertiary);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    font-size: 0.875em;
    color: var(--color-accent-light);
  }

  .prose :global(pre) {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: var(--color-text);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: var(--font-size-sm);
  }

  .prose :global(th) {
    background: var(--color-bg-secondary);
    color: var(--color-text);
    font-weight: 600;
    padding: 0.75rem 1rem;
    text-align: left;
    border: 1px solid var(--color-border);
  }

  .prose :global(td) {
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .prose :global(tr:nth-child(even) td) {
    background: var(--color-bg-secondary);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }

  /* ---- SIDEBAR ---- */
  .blog-post__author-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-bottom: 1.5rem;
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--color-accent-light);
    flex-shrink: 0;
    border: 1px solid var(--color-accent);
  }

  .author-name {
    font-weight: 600;
    font-size: var(--font-size-sm);
    margin-bottom: 0.25rem;
  }

  .author-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .blog-post__share {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .share-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
  }

  .share-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: all 0.2s;
  }

  .share-btn--twitter {
    background: rgba(29, 161, 242, 0.1);
    color: #1da1f2;
    border: 1px solid rgba(29, 161, 242, 0.3);
  }

  .share-btn--twitter:hover {
    background: rgba(29, 161, 242, 0.2);
  }

  @media (max-width: 900px) {
    .blog-post__content-wrap {
      grid-template-columns: 1fr;
    }

    .blog-post__sidebar {
      order: -1;
    }
  }
</style>
